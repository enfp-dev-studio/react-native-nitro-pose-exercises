{
  "name": "@enfp-dev-studio/react-native-nitro-pose-exercises",
  "version": "1.1.19-enfp.2",
  "description": "Maintained Nitro Pose fork with asynchronous inference, motion tracking, and a pure TypeScript Full/Knee push-up counter.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./counter": {
      "source": "./src/counter/index.ts",
      "types": "./lib/typescript/src/counter/index.d.ts",
      "default": "./lib/module/counter/index.js"
    },
    "./overlay": {
      "source": "./src/overlay/index.ts",
      "types": "./lib/typescript/src/overlay/index.d.ts",
      "default": "./lib/module/overlay/index.js"
    },
    "./camera": {
      "source": "./src/camera/index.ts",
      "types": "./lib/typescript/src/camera/index.d.ts",
      "default": "./lib/module/camera/index.js"
    }
  },
  "files": [
    "src",
    "lib/module",
    "lib/typescript",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "compatibility.json",
    "app.plugin.js",
    "plugin"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enfp-dev-studio/react-native-nitro-pose-exercises.git"
  },
  "author": "Gautham495 <kinggautham495@gmail.com> (https://github.com/Gautham495)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/enfp-dev-studio/react-native-nitro-pose-exercises/issues"
  },
  "homepage": "https://github.com/enfp-dev-studio/react-native-nitro-pose-exercises#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@shopify/react-native-skia": "2.6.2",
    "@types/react": "^19.2.0",
    "commitlint": "^20.5.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.4",
    "nitrogen": "0.37.1",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "0.41.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "^15.15.5",
    "react-native-vision-camera": "5.2.3",
    "react-native-worklets": "0.10.1",
    "typescript": "6.0.3",
    "react-native-nitro-image": "0.15.2",
    "@react-native/metro-config": "0.86.3",
    "expo": "57.0.20",
    "expo-build-properties": "57.0.17"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "0.37.1",
    "react-native-vision-camera": "5.2.3",
    "@shopify/react-native-skia": "2.6.2",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "expo": "57.0.20",
    "expo-build-properties": "57.0.17"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it",
      "vite"
    ],
    "version": "0.62.0"
  },
  "private": true,
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    },
    "react-native-vision-camera": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-build-properties": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "nitrogen": "nitrogen",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "node --experimental-strip-types --test tests/counter/*.test.ts tests/overlay/*.test.ts tests/plugin/*.test.cjs",
    "test:plugin": "node --test tests/plugin/*.test.cjs",
    "build": "bob build",
    "test:package": "node scripts/pack-smoke.mjs",
    "test:counter": "node --experimental-strip-types --test tests/counter/*.test.ts",
    "example:start": "pnpm --dir example start",
    "example:android": "pnpm --dir example android",
    "example:ios": "pnpm --dir example ios",
    "prepare": "bob build",
    "prepack": "bob build",
    "test:git-install": "node scripts/git-install-smoke.mjs",
    "test:git-install:yarn": "node scripts/git-install-smoke.mjs --yarn"
  }
}
